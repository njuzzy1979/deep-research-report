    "dimension_scores": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "outline_coverage",
          "evidence_density",
          "cd_source_qualifier",
          "no_vague_source",
          "strong_claim",
          "logic_word",
          "negative_evidence_check",
          "conclusion_para",
          "contribution_limitation",
          "numbered_list_audit",
          "structural_consistency",
          "figure_reference",
          "card_backfill",
          "card_overlap",
          "C1_h1",
          "C2_manual_number",
          "C3_image_syntax",
          "C4_table_caption",
          "C5_banned",
          "QS1_wordcount",
          "QS2_figures",
          "QS3_tables",
          "QS4_paragraphs",
          "chapter_transition",
          "reader_calibration",
          "P1_tech_metrics",
          "P2_innovation",
          "P3_trl",
          "P4_milestone",
          "P5_research_base"
        ]
      },
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "verdict": {
            "type": "string",
            "enum": [
              "pass",
              "warn",
              "block"
            ]
          },
          "evidence": {
            "type": "string"
          }
        },
        "required": [
          "verdict",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dimension": {
            "type": "string",
            "enum": [
              "outline_coverage",
              "evidence_density",
              "cd_source_qualifier",
              "no_vague_source",
              "strong_claim",
              "logic_word",
              "negative_evidence_check",
              "conclusion_para",
              "contribution_limitation",
              "numbered_list_audit",
              "structural_consistency",
              "figure_reference",
              "card_backfill",
              "card_overlap",
              "C1_h1",
              "C2_manual_number",
              "C3_image_syntax",
              "C4_table_caption",
              "C5_banned",
              "QS1_wordcount",
              "QS2_figures",
              "QS3_tables",
              "QS4_paragraphs",
              "chapter_transition",
              "reader_calibration",
              "P1_tech_metrics",
              "P2_innovation",
              "P3_trl",
              "P4_milestone",
              "P5_research_base"
            ]
          },
          "location": {
            "type": "string"
          },
          "problem": {
            "type": "string"
          },
          "suggested_fix": {
            "type": "string"
          }
        },
        "required": [
          "dimension",
          "location",
          "problem",
          "suggested_fix"
        ],
        "additionalProperties": false
      }
    }
