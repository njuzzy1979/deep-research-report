{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deep-research-report.local/schemas/auditor-phase-a.schema.json",
  "title": "Phase A 审计盲态预承诺（确认式）落盘格式",
  "description": "chapter_auditor_agent Phase A 盲态预承诺的 JSON 落盘形态（方案 §C4 tier B/C 确认式）。顶层键为章标识（如 'ch01'），每章下键为维度 id，值为 {mode: confirm|adjust, text?}。当前维度 id 枚举共 7 个核心维度 + 5 个立项扩展维度。",
  "x-generated-from": "agents/contracts/auditor_contract.json#/dimensions,/proposal_extra (维度id枚举，自动派生) + design/model-compatibility-optimization-plan.md#C4 (confirm/adjust JSON落盘形态，人工设计)",
  "type": "object",
  "propertyNames": {
    "pattern": "^ch\\d{2,3}$"
  },
  "minProperties": 1,
  "additionalProperties": {
    "type": "object",
    "propertyNames": {
      "enum": [
        "D1_argument_depth",
        "D2_honest_expression",
        "D3_traceability",
        "D4_card_digestion",
        "D5_structure",
        "D6_compliance",
        "D7_proposal",
        "P1_tech_metrics",
        "P2_innovation",
        "P3_trl",
        "P4_milestone",
        "P5_research_base"
      ]
    },
    "minProperties": 1,
    "additionalProperties": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "confirm",
            "adjust"
          ]
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "if": {
        "properties": {
          "mode": {
            "const": "adjust"
          }
        }
      },
      "then": {
        "required": [
          "mode",
          "text"
        ]
      },
      "additionalProperties": false
    }
  }
}
